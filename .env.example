# Copy to .env then run:  python scripts/setup.py install
# Full guide: docs/LOCAL_SETUP.md
# The API reads gawah-backend/.env (setup syncs keys from this file when empty).

# Frontend (legacy Next client only)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend — prefer gawah-backend/.env for local API runs
UPLIFTAI_API_KEY=
UPLIFT_ASSISTANT_ID=
UPLIFT_BASE_URL=https://ap-southeast-1.api.upliftai.org/v1
# Male Standard Urdu (Uplift Orator) — https://docs.upliftai.org/orator_voices
UPLIFT_TTS_VOICE_ID=defense-advocate
UPLIFT_TTS_OUTPUT_FORMAT=MP3_22050_128

# OpenRouter LLM (primary)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini + Cloud STT/TTS (optional — see gawah-backend/.env.example)
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
# Phone calling uses Uplift Singapore POST /calls (no Twilio required for Call Me).
# For inbound "dial Gawah": point Twilio Voice webhook → POST /api/sessions/twilio-webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NGO_WEBHOOK_URL=
CASE_ID_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
