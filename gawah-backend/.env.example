APP_NAME=Gawah API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Uplift AI (use Singapore from Pakistan — required for phone calling)
UPLIFTAI_API_KEY=
UPLIFT_ASSISTANT_ID=
UPLIFT_BASE_URL=https://ap-southeast-1.api.upliftai.org/v1
UPLIFT_TTS_VOICE_ID=ai_lwr_f_fb
UPLIFT_TTS_OUTPUT_FORMAT=MP3_22050_128

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Supabase (empty = local JSON store)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Twilio (optional PSTN)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# NGO escalation webhook
NGO_WEBHOOK_URL=

CASE_ID_SECRET=change-me-in-production
